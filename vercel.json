{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "functions": {
        "api/news.py": {
          "maxDuration": 60,
          "includeFiles": "{backend/news_service.py,backend/news_collector.py,backend/news_retriever.py,data/news_corpus/**}",
          "excludeFiles": "{backend/test_*.py,backend/train_model.py,backend/tune_*.py,backend/backtest.py,backend/compare_*.py,backend/audit_*.py,xgboost_ohlcv_bundle.pkl,*_report.json,dist/**,node_modules/**}"
        },
        "api/backtest.js": {
          "includeFiles": "news_overlay_tuning_report.json"
        }
      },
      "rewrites": [
        {
          "source": "/((?!api/).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "app"
      }
    }
  ]
}
