# The web server forwards prediction requests to this backend address.
PREDICT_API_URL=http://127.0.0.1:5000/predict
# Optional Python server configuration:
# PREDICT_HOST=127.0.0.1
# PREDICT_PORT=5000
# MODEL_FILE=/absolute/path/to/model.pkl
# Keep the checked-in model frozen for a stable demo. Set both values to true
# only when running a persistent training service.
AUTO_RETRAIN_DAILY=false
AUTO_RETRAIN_ON_START=false
# AUTO_RETRAIN_TIME=18:00
# AUTO_RETRAIN_TIMEZONE=Asia/Jakarta
# AUTO_RETRAIN_RETRY_SECONDS=900
# NEWS_UPDATE_DAILY=false
# NEWS_REFRESH_DAYS=10

# Reserved for a future Groq-powered news explanation endpoint.
# Never commit the real key.
GROQ_API_KEY=
