# Vercel serverless configuration. Add these in Project Settings > Environment Variables.
# Never commit real API keys.
GROQ_API_KEY=

# Optional comma-separated backup keys. Leave empty when no backup key is available.
GROQ_API_KEYS=

# Optional preferred order. Leave empty to use the built-in chain and active-model discovery.
GROQ_MODELS=

# PREDICT_API_URL, NEWS_API_URL, and AUTO_RETRAIN_* are intentionally absent.
# Same-origin /api functions handle inference and news; retraining is an offline job.
